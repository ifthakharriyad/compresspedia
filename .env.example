# Server
# Port the Express server listens on (default 3000)
PORT=3000

# Ghostscript home path used by PDF compression (example)
# Set to the system path where gs/ghostscript is installed, e.g. /usr/bin or /usr/lib
GS4JS_HOME=/path/to/ghostscript

# File storage locations (relative to project root)
UPLOAD_DIR=uploads
COMPRESSED_DIR=compressed

# Max upload size per file in MB (used by your deployment/config)
MAX_UPLOAD_SIZE_MB=100

# Node environment
NODE_ENV=development

# Frontend (Create React App) — client/.env uses REACT_APP_* variables
# REACT_APP_* variables are embedded into the client bundle at build time.
# Set REACT_APP_API_BASE_URL to your backend endpoint (omit trailing slash).
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_PROXY=http://localhost:3000

# Optional (examples if you later add auth or external services)
# Example: third-party API key (do NOT put real keys here)
# EXTERNAL_SERVICE_API_KEY=your_api_key_here
# NOTE: prefer secrets managers instead of storing keys in files.
